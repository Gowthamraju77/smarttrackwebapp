# Public maps, place search and road planning require no secrets.
# Copy to .env.local only when configuring optional services with YOUR values.

# Private remote device feed; set these in Vercel for your own relay.
SMARTTRACK_VIEWER_SECRET=
SMARTTRACK_RELAY_SECRET=
SMARTTRACK_LIVE_RELAY_URL=
# Set to 1 to share read-only telemetry on the normal website URL. Redeploy after changing.
# Viewer tokens remain required when this flag is absent; relay credentials always stay private.
SMARTTRACK_PUBLIC_LIVE=

# Optional Supabase backend and browser login.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional separate ML service.
SMARTTRACK_ML_URL=
SMARTTRACK_ML_SHARED_SECRET=

# Local Windows relay only; choose YOUR device's actual port.
SMARTTRACK_SERIAL_PORT=
SMARTTRACK_RELAY_PORT=4317
# Use infoesp to read an existing collector instead of opening a serial port.
SMARTTRACK_RELAY_INPUT=serial
SMARTTRACK_INFOESP_URL=

# Optional contact registry and scheduled email + SMS. Apply database/notifications.sql.
# Uses SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SMARTTRACK_VIEWER_SECRET and APP_ORIGIN above.
# Run the authenticated scheduler every minute; see docs/NOTIFICATIONS.md.
CRON_SECRET=
RESEND_API_KEY=
SMARTTRACK_EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
